diff --git a/platform/hmg_gen5w.mk b/platform/hmg_gen5w.mk
new file mode 100644
index 0000000..0f3c5d1
--- /dev/null
+++ b/platform/hmg_gen5w.mk
@@ -0,0 +1,11 @@
+# HMG-Seogaemo: Hyundai/Kia/Genesis Gen5W head units (Telechips tcc803x and
+# tcc897x, little-endian ARMv7, Linux 3.18.24-tcc). hostapd and
+# wpa_supplicant drive the dongle through nl80211.
+ifeq ($(CONFIG_PLATFORM_HMG_GEN5W), y)
+EXTRA_CFLAGS += -DCONFIG_LITTLE_ENDIAN
+EXTRA_CFLAGS += -DCONFIG_IOCTL_CFG80211 -DRTW_USE_CFG80211_STA_EVENT
+EXTRA_CFLAGS += -DCONFIG_RADIO_WORK
+# GCC 4.7 predates SOURCE_DATE_EPOCH; pin the build stamp for reproducible objects.
+EXTRA_CFLAGS += -Wno-builtin-macro-redefined -D__DATE__=\"HMG-Seogaemo\" -D__TIME__=\"pinned\"
+_PLATFORM_FILES += platform/platform_ops.o
+endif
