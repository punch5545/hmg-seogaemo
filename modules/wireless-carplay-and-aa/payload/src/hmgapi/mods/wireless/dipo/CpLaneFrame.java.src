// HMG-Seogaemo: independently implemented lane encoding for Android Auto, on the car-verified cluster lane format.
package hmgapi.mods.wireless.dipo;

/**
 * One lane as the cluster's per-lane values: the status byte (2 bits per arrow slot, 00 not
 * drawn, 01 white, 10 blue, 11 grey) and up to three arrow image ids
 * (.agents/cluster-lane-arrows.md). The single colour rule for CarPlay (CpTurns.laneValues) and
 * Android Auto (AaTurns): the arrows on the route are blue, the other arrows of that lane grey, and a
 * lane with no route arrow takes the caller's idle colour. The caller hands over each lane's
 * direction classes (CpTurns.laneIcon values 1..8, the plain glyph ids) and which of its arrow
 * slots are on the route; this turns them into the overlaid component glyphs a multi-direction
 * lane needs.
 */
public final class CpLaneFrame {
    public static final int WHITE = 1, BLUE = 2, GREY = 3;

    private CpLaneFrame() {}

    /**
     * @param arrows   the lane's arrow slots as direction classes 1..8 (0: unused), at most 8
     * @param recMask  bit k set: the direction in slot k is on the route
     * @param laneIdle the colour of every arrow of a lane with no recommended direction (WHITE, or GREY
     *                 while other lanes of the frame are recommended)
     * @return {status byte, image id of slot 0, 1, 2}
     */
    public static int[] lane(int[] arrows, int recMask, int laneIdle) {
        int[] cls = new int[8];
        boolean[] rec = new boolean[8];
        int n = 0;
        for (int k = 0; k < arrows.length && k < 8; k++) {
            int c = arrows[k];
            if (c < 1 || c > 8) continue;
            int i = 0;
            while (i < n && cls[i] != c) i++;
            if (i == n) cls[n++] = c;
            if ((recMask >> k & 1) != 0) rec[i] = true;
        }
        int[] r = new int[4];
        if (n == 0) {
            r[0] = laneIdle;
            return r;
        }
        boolean anyRec = false;
        for (int i = 0; i < n; i++) anyRec |= rec[i];
        boolean snap = false;
        int[][] row = CpTurns.LaneGlyphs.find(cls, n, false);
        if (row == null) {
            row = CpTurns.LaneGlyphs.find(cls, n, true);
            snap = row != null;
        }
        if (row == null) {
            // not a verified set: only the route arrow, else the first, as a single plain glyph
            int pick = 0;
            for (int i = n - 1; i >= 0; i--) if (rec[i]) pick = i;
            row = new int[][] { { cls[pick] }, { cls[pick] } };
            rec = new boolean[] { rec[pick], false, false };
            cls = new int[] { cls[pick], 0, 0 };
            n = 1;
        }
        for (int j = 0; j < row[0].length; j++) {
            boolean slotRec = false;
            for (int i = 0; i < n; i++) if (rec[i] && CpTurns.LaneGlyphs.fold(cls[i], snap) == row[0][j]) slotRec = true;
            int colour = !anyRec ? laneIdle : slotRec ? BLUE : GREY;
            r[0] |= colour << (2 * j);
            r[1 + j] = row[1][j];
        }
        return r;
    }
}
