package hmgapi.mods.wireless.dipo;

import java.util.Locale;

/** Original HMG-Seogaemo PE14 selector, using observed stock pictures, not OEM source.
 * This is a best-fit diagram: CarPlay supplies no lane connectivity, median shape or
 * picture identifier. Callers own visibility, distance gates and clearing the display.
 */
final class CpJunctions {
    private CpJunctions() {}
    private static final int NONE = 65535;
    private static final int EXIT = 0, FORK = 1, Y = 2, POCKET = 3, LOOP = 4, MULTI = 5;

    /** Return {picture A, route highlight B, optional highlight C}, or null when
     * there is insufficient junction evidence. No calls, state or input mutation.
     * hasExit distinguishes a measured straight (0 degrees) from an absent angle;
     * hasSide describes traffic handedness, never the chosen branch.
     */
    static int[] select(CpTurns.Maneuver current, CpTurns.Maneuver next, CpLaneDecoder.Info lanes) {
        // Exits only. Keeps, forks and straight-on have no reliable picture: on the car a lane
        // recommendation (one lane of five) drew Y splits that were not on the road.
        if (current == null || current.junction != 0 || !offRamp(current.type)) return null;
        Evidence e = new Evidence(current, lanes);
        // Every picture draws a fixed number of lanes; without the phone's lanes at this
        // maneuver the picture would show a road that isn't there (e.g. two lanes on a
        // one-lane ramp). The route update's lane count is the number of lane guidance
        // entries, not lanes, and is never used.
        if (e.count == 0) return null;
        String text = text(current);
        int routeSide = maneuverSide(current);
        if (routeSide == 0) routeSide = e.routeSide();
        if (routeSide == 0) return null;
        // Only when the phone recommends the lanes on the exit edge; a lane change still to
        // come or a middle lane has no matching picture.
        if (CpGuidance.laneSide(lanes) != routeSide) return null;
        int chosen = routeSide, branchSide = routeSide;
        boolean loopCue = contains(text, new String[] {"loop", "cloverleaf", "루프"});

        int family = EXIT;
        boolean noThrough = e.possible[1] == 0 && e.possible[0] > 0 && e.possible[2] > 0;
        boolean fan = e.distinct >= 4 || e.possible[0] > 0 && e.possible[1] > 0 && e.possible[2] > 0;
        boolean pocket = contains(text, new String[] {"pocket", "zig-zag", "zigzag", "포켓"});
        // Angles establish topology; textual shape words only refine a split
        // already supported by the maneuver/lanes. They are never decoded from B.
        if (noThrough) family = Y;
        if (fan && e.count >= 4) family = MULTI;
        if (pocket && (noThrough || e.split())) family = POCKET;
        boolean hooksBack = current.hasExit && valid(current.exit) && current.exit >= 120
                || e.maxRouteAngle >= 120;
        if (chosen > 0 && hooksBack) family = LOOP;
        if (loopCue && chosen > 0 && e.split()) family = LOOP;
        // There is no observed left-loop family. Do not mirror right-loop codes.
        if (chosen < 0 && current.hasExit && current.exit <= -120) return null;

        int best = Integer.MIN_VALUE, bestA = 0, bestB = 0;
        short[] pictures = CpJunctionTable.PICTURES, highlights = CpJunctionTable.HIGHLIGHTS;
        for (int h = 0; h < highlights.length; h += 5) {
            int p = highlights[h] * 4, a = pictures[p], layout = pictures[p + 1];
            int route = highlights[h + 2], side = highlights[h + 3];
            // Even lane_variant with a side has no established maneuver meaning.
            if (route == CpJunctionTable.ROUTE_LANE_VARIANT) continue;
            boolean through = route == CpJunctionTable.ROUTE_STRAIGHT || route == CpJunctionTable.ROUTE_MAIN_CURVE;
            if (through || side != chosen) continue;
            int layoutFamily = family(layout);
            // Shape has priority over lane width; no semantically different fallback.
            if (family != layoutFamily) continue;
            int pictureSide = pictures[p + 3];
            if ((family == EXIT || family == FORK || family == LOOP) && pictureSide != branchSide) continue;
            if (pictures[p + 2] != e.count) continue;
            int score = 100;
            if (highlights[h + 4] != 0) score += 5;
            if ((family == Y || family == POCKET) &&
                    (route == CpJunctionTable.ROUTE_LEFT_BRANCH || route == CpJunctionTable.ROUTE_RIGHT_BRANCH)) score += 4;
            // Known stock pairs break otherwise unresolvable ties, not geometry.
            if (a == 10193) score += 3;
            if (a == 10168) score += 2;
            // Two consecutive ramps weakly favor the second observed stock diagram.
            if (a == 10168 && next != null && offRamp(next.type) && sameRoad(current, next)) score += 2;
            if (score > best) { best = score; bestA = a; bestB = highlights[h + 1]; }
        }
        return bestA == 0 ? null : new int[] {bestA, bestB, NONE};
    }

    /** Road name or instruction names a highway (shared with CpGuidance). */
    static boolean highwayCue(CpTurns.Maneuver m) { return highway(text(m)); }
    private static boolean offRamp(int type) { return type == 8 || type == 22 || type == 23; }
    private static int maneuverSide(CpTurns.Maneuver m) {
        switch (m.type) {
            case 1: case 13: case 22: case 49: case 52: return -1;
            case 2: case 14: case 23: case 50: case 53: return 1;
            default: return m.hasExit && valid(m.exit) ? direction(m.exit) : 0;
        }
    }
    private static boolean valid(int a) { return a >= -180 && a <= 180; }
    private static int direction(int a) { return a < -15 ? -1 : a > 15 ? 1 : 0; }
    private static int family(int layout) {
        switch (layout) {
            case CpJunctionTable.LAYOUT_FORK_LEFT: case CpJunctionTable.LAYOUT_FORK_RIGHT: return FORK;
            case CpJunctionTable.LAYOUT_OTHER: case CpJunctionTable.LAYOUT_Y: return Y;
            case CpJunctionTable.LAYOUT_Y_POCKET: return POCKET;
            case CpJunctionTable.LAYOUT_LOOP_RIGHT: return LOOP;
            case CpJunctionTable.LAYOUT_MULTI: return MULTI;
            default: return EXIT;
        }
    }
    static String text(CpTurns.Maneuver m) {
        return ((m.description == null ? "" : m.description) + " "
                + (m.afterRoad == null ? "" : m.afterRoad)).toLowerCase(Locale.US);
    }
    private static boolean contains(String text, String[] words) {
        for (String word : words) if (text.indexOf(word) >= 0) return true;
        return false;
    }
    private static boolean highway(String text) {
        return contains(text, new String[] {"highway", "motorway", "expressway", "freeway",
                "off-ramp", "off ramp", "interchange", "고속", "도시고속", "분기점", "나들목"});
    }
    private static boolean sameRoad(CpTurns.Maneuver a, CpTurns.Maneuver b) {
        return a.afterRoad != null && a.afterRoad.length() != 0 && a.afterRoad.equals(b.afterRoad);
    }

    /** Every lane contributes geometry, including NotGood. Only Good/Preferred
     * lanes contribute route votes; explicit highlights weigh more than arrows.
     * Multiple unhighlighted arrows share a vote instead of inventing a route.
     */
    private static final class Evidence {
        final int[] possible = new int[3], votes = new int[3];
        final boolean[] bearings = new boolean[25];
        int count, distinct, maxRouteAngle;
        Evidence(CpTurns.Maneuver m, CpLaneDecoder.Info info) {
            int actual = info == null || info.lanes == null ? 0 : info.lanes.length;
            count = actual;
            if (m.angles != null) for (int angle : m.angles) geometry(angle);
            if (m.hasExit) geometry(m.exit);
            if (actual == 0) return;
            for (CpLaneDecoder.Lane lane : info.lanes) {
                if (lane == null) continue;
                int[] local = new int[3];
                if (lane.angles != null) for (int angle : lane.angles) {
                    geometry(angle);
                    if (valid(angle)) local[direction(angle) + 1]++;
                }
                // A highlight need not be repeated in LaneAngles (iOS behavior).
                if (valid(lane.highlight)) geometry(lane.highlight);
                int weight = lane.status == 2 ? 6 : lane.status == 1 ? 3 : 0;
                if (weight == 0) continue;
                if (valid(lane.highlight)) {
                    int dir = direction(lane.highlight);
                    votes[dir + 1] += weight * 3;
                    maxRouteAngle = Math.max(maxRouteAngle, lane.highlight);
                } else {
                    int directions = 0;
                    for (int n : local) if (n > 0) directions++;
                    if (directions != 0) for (int k = 0; k < 3; k++)
                        if (local[k] > 0) votes[k] += weight * 3 / directions;
                }
            }
        }
        private void geometry(int angle) {
            if (!valid(angle)) return;
            possible[direction(angle) + 1]++;
            int bin = (angle + 180 + 7) / 15;
            if (!bearings[bin]) { bearings[bin] = true; distinct++; }
        }
        boolean split() {
            int n = 0; for (int k : possible) if (k > 0) n++; return n >= 2;
        }
        int routeSide() {
            return votes[0] > votes[2] && votes[0] > votes[1] ? -1
                    : votes[2] > votes[0] && votes[2] > votes[1] ? 1 : 0;
        }
    }
}
