// HMG-Seogaemo: the USB CarPlay hotspot published by the wifi module. SPDX-License-Identifier: AGPL-3.0-or-later
package hmgapi.mods.wireless;

import android.net.wifi.WifiConfiguration;

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.util.HashMap;
import java.util.Map;

/**
 * The CarPlay hotspot on the USB Wi-Fi adapter, as the wifi module publishes it with sg_peer_publish
 * (root-only key=value file, contract "Peer info"). Wireless.zygoteInit reads it once, as root in the
 * zygote before apps fork; the values live only in these statics of the mod's loader, which every app
 * and app part shares (never in properties or files an app can read). Only radio=usb with valid values
 * counts; a missing file, a parse error or any other radio means the stock hotspot, exactly as before.
 * `ready` is not consulted: the zygote starts before this boot's reconcile publishes it again. A changed
 * wifi role therefore takes effect after a head-unit restart (restart=head_unit in both modules).
 */
public final class UsbHotspot {
    static final File PEER = new File("/data/nemesis/backup/hmg-seogaemo/peer/wifi");
    /** the interface name GPM's host locator looks for, and the name the built-in one reports instead */
    static final String STOCK = "wlan0", STOCK_RENAMED = "wlan0-builtin";
    /** WifiConfiguration.KeyMgmt.WPA2_PSK, hidden on API 19; the iAP2 server logs auth type 4 as WPA2_PSK */
    static final int KEY_MGMT_WPA2_PSK = 4;
    static final int LIMIT = 4096;
    /** WifiManager.getWifiApMode() of the hotspot "for connectivity", the one GPM's start check wants */
    static final int AP_MODE_CONNECTIVITY = 2;
    /** IFF_UP in /sys/class/net/<iface>/flags */
    static final int IFF_UP = 1;
    /** replaced by the host test */
    static File sysNet = new File("/sys/class/net");
    /** the hotspot channel when the wifi module published none: 2.4 GHz channel 6, the one it runs (modules/wifi ap_channel) */
    static final int DEFAULT_CHANNEL = 6;
    /** the 5 GHz channel frequencies HKMC_GPM's version request hard-codes, as MHz: 5745 (149) and 5180 (36) */
    static final int STOCK_FREQ_FIRST = 5745, STOCK_FREQ_SECOND = 5180;
    static final String CHANNELS_24 = "CHANNELS_24GHZ_ONLY", CHANNELS_5 = "CHANNELS_5GHZ_ONLY";
    private static volatile String iface, ssid, passphrase;
    private static volatile int channel;

    private UsbHotspot() {}

    public static boolean active() { return iface != null; }

    public static String iface() { return iface; }

    /** Reads the published hotspot; returns a short reason (no credentials) for the runtime record. Never throws. */
    static String snapshot() {
        clear();
        try {
            if (!PEER.isFile()) return "stock: no published hotspot";
            return use(parse(read(PEER)));
        } catch (Throwable t) {
            clear();
            return "stock: unreadable (" + t.getClass().getSimpleName() + ")";
        }
    }

    /** key=value lines; the first value of a key wins, as sg_peer_info reads it */
    static Map<String, String> parse(String text) {
        Map<String, String> values = new HashMap<String, String>();
        for (String line : text.split("\n")) {
            int eq = line.indexOf('=');
            if (eq <= 0) continue;
            String key = line.substring(0, eq);
            if (!values.containsKey(key)) values.put(key, line.substring(eq + 1));
        }
        return values;
    }

    static String use(Map<String, String> values) {
        clear();
        String radio = values.get("radio");
        if (!"usb".equals(radio)) return "stock: radio=" + radio;
        String i = values.get("interface"), ip = values.get("ip"), s = values.get("ssid"), p = values.get("passphrase");
        if (i == null || !i.matches("[a-zA-Z0-9_.-]{1,15}") || STOCK.equals(i) || STOCK_RENAMED.equals(i))
            return "stock: invalid interface";
        if (ip == null || !ip.matches("([0-9]{1,3}\\.){3}[0-9]{1,3}")) return "stock: invalid ip";
        if (s == null || s.length() < 1 || s.length() > 32 || !printable(s)) return "stock: invalid ssid";
        if (p == null || p.length() < 8 || p.length() > 63 || !printable(p)) return "stock: invalid passphrase";
        ssid = s;
        passphrase = p;
        int ch = parseChannel(values.get("channel"));
        channel = frequencyMhz(ch) > 0 ? ch : DEFAULT_CHANNEL;
        iface = i;
        return "usb: " + i + " " + ip;
    }

    static void clear() {
        iface = null;
        ssid = null;
        passphrase = null;
        channel = 0;
    }

    static int parseChannel(String text) {
        if (text == null || !text.matches("[0-9]{1,3}")) return 0;
        return Integer.parseInt(text);
    }

    /** centre frequency of a 2.4 GHz (1-14) or 5 GHz (36-64, 100-144, 149-177) channel; 0 for any other number */
    static int frequencyMhz(int ch) {
        if (ch >= 1 && ch <= 13) return 2407 + 5 * ch;
        if (ch == 14) return 2484;
        if ((ch >= 36 && ch <= 64 || ch >= 100 && ch <= 144) && ch % 4 == 0 || ch >= 149 && ch <= 177 && ch % 4 == 1) return 5000 + 5 * ch;
        return 0;
    }

    static boolean printable(String s) {
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            if (c < 0x20 || c > 0x7e) return false;
        }
        return true;
    }

    static String read(File f) throws IOException {
        InputStream in = new FileInputStream(f);
        try {
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            byte[] b = new byte[512];
            int n;
            while ((n = in.read(b)) > 0) {
                out.write(b, 0, n);
                if (out.size() > LIMIT) throw new IOException("oversized peer file");
            }
            return out.toString("UTF-8");
        } finally {
            in.close();
        }
    }

    /**
     * The hotspot as WifiManager.getWifiApConfiguration() reports it: the published SSID and passphrase in
     * the AOSP fields and in Hyundai's ConnectivitySSID/ConnectivityPSK (set only where this framework has
     * them), WPA2-PSK as the only key management so getAuthType() returns WPA2_PSK (AOSP 4.4 logic: the one
     * set KeyMgmt bit; the car's framework source is not available, so this is an assumption).
     */
    public static WifiConfiguration apConfiguration() {
        String s = ssid, p = passphrase;
        if (iface == null || s == null || p == null) throw new IllegalStateException("no USB hotspot");
        WifiConfiguration c = new WifiConfiguration();
        c.SSID = s;
        c.preSharedKey = p;
        c.allowedKeyManagement.clear();
        c.allowedKeyManagement.set(KEY_MGMT_WPA2_PSK);
        setIfPresent(c, "ConnectivitySSID", s);
        setIfPresent(c, "ConnectivityPSK", p);
        return c;
    }

    static void setIfPresent(Object target, String field, String value) {
        try {
            target.getClass().getField(field).set(target, value);
        } catch (NoSuchFieldException absent) {
            // not this framework's field
        } catch (IllegalAccessException e) {
            throw new IllegalStateException(field, e);
        }
    }

    /**
     * NetworkInterface.getName()/getDisplayName() in GPM: its host locator takes the first site-local
     * IPv4 interface named "wlan0" (host IP and BSSID; AA port 40515), so the USB interface reports
     * "wlan0" and a real wlan0 (e.g. the built-in radio as a client) reports another name.
     */
    public static String gpmName(String name) {
        String i = iface;
        if (i == null || name == null) return name;
        if (name.equals(i)) return STOCK;
        if (name.equals(STOCK)) return STOCK_RENAMED;
        return name;
    }

    /**
     * Whether the adapter's interface is up now: hostapd runs on a transient, replug-able adapter, so this is read at
     * each call rather than from the zygote snapshot. Needs no permission beyond reading /sys/class/net.
     */
    public static boolean apUp() {
        String i = iface;
        if (i == null) return false;
        try {
            String flags = read(new File(new File(sysNet, i), "flags")).trim();
            if (!flags.startsWith("0x")) return false;
            return (Long.parseLong(flags.substring(2), 16) & IFF_UP) != 0;
        } catch (Throwable t) {
            return false;
        }
    }

    /**
     * WifiManager.isWifiApEnabled() as GPM sees it. GPM's start request (WirelessExplorer.handleStartRequest) answers
     * the phone STATUS_WIFI_DISABLED, and Android Auto goes no further than its popup, unless the stock hotspot is
     * enabled and in mode 2. With the hotspot on the adapter the stock one is off (the car may have no built-in
     * chip), so while the adapter's interface is up GPM is told the hotspot is enabled.
     */
    public static boolean gpmApEnabled(boolean real) {
        return real || apUp();
    }

    /** WifiManager.getWifiApMode() as GPM sees it; see gpmApEnabled */
    public static int gpmApMode(int real) {
        return apUp() ? AP_MODE_CONNECTIVITY : real;
    }

    /** the hotspot's frequency in MHz, from the published channel (DEFAULT_CHANNEL if none or invalid) */
    public static int frequency() {
        return frequencyMhz(channel);
    }

    /**
     * What GPM's WifiVersionRequest says about the bands, name of the WifiChannelType value. Stock hard-codes
     * CHANNELS_5GHZ_ONLY with 5745 and 5180 MHz (WirelessExplorer.sendVersionRequestMessage), so a phone would not
     * look for a 2.4 GHz hotspot. Null leaves the stock value (no USB hotspot, or its interface is down).
     */
    public static String gpmChannelType() {
        if (!apUp()) return null;
        return frequency() < 3000 ? CHANNELS_24 : CHANNELS_5;
    }

    /**
     * One addSupportedWifiChannels(MHz) call of that request: the first stock frequency becomes the hotspot's, the
     * second is dropped (-1), anything else stays. Stock when the hotspot is not up.
     */
    public static int gpmFrequency(int stock) {
        if (!apUp()) return stock;
        if (stock == STOCK_FREQ_FIRST) return frequency();
        if (stock == STOCK_FREQ_SECOND) return -1;
        return stock;
    }

    /**
     * WifiData.setSupportedChannels(int[]) in GPM: stock sets {5745, 5180}, which CarWifiStub puts into the
     * CarWifiCredentials it hands the phone over the projection channel. The hotspot's frequency instead, while it is up.
     */
    public static int[] gpmChannels(int[] stock) {
        return apUp() ? new int[] { frequency() } : stock;
    }
}
