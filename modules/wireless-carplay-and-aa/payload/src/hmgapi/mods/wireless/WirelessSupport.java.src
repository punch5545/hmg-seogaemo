// Modified by HMG-Seogaemo: what the single-module ModContext did for the wireless mod,
// now on top of the core hook host. SPDX-License-Identifier: AGPL-3.0-or-later
package hmgapi.mods.wireless;

import dalvik.system.DexClassLoader;
import hmgapi.engine.MemRecipe;
import hmgapi.hook.AppPartLoader;
import hmgapi.hook.LoadedApp;
import hmgapi.hook.ModContext;
import hmgapi.hook.NativePatch;
import hmgapi.hook.RuntimeResult;
import java.io.File;
import java.util.ArrayList;
import java.util.List;

/** Per-app runtime records, app parts and native recipes of the wireless mod. */
public final class WirelessSupport {
    /** World-readable copy of this mod's jar: app processes cannot read the core's root-only copy. */
    static final String PARTS_JAR = "/system/framework/hmg-seogaemo-wireless-parts.jar";
    static final File ASSETS = new File("/system/etc/hmg-seogaemo/wireless-carplay-and-aa");
    private WirelessSupport() {}

    public static void beginRuntime(LoadedApp app) {
        try { RuntimeResult.begin(app.context.getDir("hmg-seogaemo-wireless-runtime", 0), app.packageName, app.processName); }
        catch (Throwable ignored) {}
    }

    public static Class<?> appPart(LoadedApp app, String className) throws Exception {
        String pkg = className.substring(0, className.lastIndexOf('.'));
        ClassLoader parent = new AppPartLoader(pkg, WirelessSupport.class.getClassLoader(), app.classLoader);
        File optimized = app.context.getDir("hmg-seogaemo-wireless-dex", 0);
        DexClassLoader loader = new DexClassLoader(PARTS_JAR, optimized.getPath(), null, parent);
        return loader.loadClass(className);
    }

    public static void nativePatch(ModContext mod, String lib) {
        try {
            List<MemRecipe> recipes = new ArrayList<MemRecipe>();
            if ("libautoreceiver_infobank.so".equals(lib)) {
                recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/aa-tbt-48ee793a.recipe")));
                recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/aa-tbt-a0bea1c4.recipe")));
            } else if ("libCarPlayCore.so".equals(lib)) recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/carplay-core-wifi.recipe")));
            else if ("libCarPlayAudio.so".equals(lib)) recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/carplay-audio-formats.recipe")));
            else if ("libCarPlayUtils.so".equals(lib)) recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/carplay-utils-converter.recipe")));
            else if ("libiap2session.so".equals(lib)) recipes.add(NativePatch.readOne(new File(ASSETS, "recipes/iap2-lane-msgid.recipe")));
            else throw new IllegalArgumentException(lib);
            NativePatch.request(mod, lib, recipes);
        } catch (Throwable t) { RuntimeResult.phase("native." + lib, "failed", "recipe registration: " + t); mod.error("native patch " + lib, t); }
    }
}
