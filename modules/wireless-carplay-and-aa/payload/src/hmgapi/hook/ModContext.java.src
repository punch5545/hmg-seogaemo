package hmgapi.hook;

// Modified by HMG-Seogaemo: fixed configuration for the one bundled wireless mod.
import dalvik.system.DexClassLoader;
import hmgapi.engine.MemRecipe;
import java.io.File;
import java.security.MessageDigest;
import java.io.FileInputStream;
import java.util.ArrayList;
import java.util.List;

public final class ModContext {
    public final String id = "wireless-carplay-and-aa";
    public final File dir = new File("/system/etc/hmg-seogaemo/wireless-carplay-and-aa");
    public java.lang.reflect.Member hook(ClassLoader cl, String point, MethodHook hook) { return Points.hook(cl, point, hook); }
    public boolean settingBoolean(String key, boolean fallback) { return fallback; }
    public String settingString(String key, String fallback) { return fallback; }
    public Class<?> appPart(LoadedApp app, String className) throws Exception {
        String pkg = className.substring(0, className.lastIndexOf('.'));
        ClassLoader parent = new AppPartLoader(pkg, ModContext.class.getClassLoader(), app.classLoader);
        File optimized = app.context.getDir("hmg-seogaemo-wireless-dex", 0);
        DexClassLoader loader = new DexClassLoader("/system/framework/hmg-seogaemo-wireless-hook.jar", optimized.getPath(), null, parent);
        return loader.loadClass(className);
    }
    public void nativePatch(LoadedApp app, String lib) {
        try {
            List<MemRecipe> recipes = new ArrayList<MemRecipe>();
            if ("libautoreceiver_infobank.so".equals(lib)) {
                recipes.add(NativePatch.readOne(new File(dir, "recipes/aa-tbt-48ee793a.recipe")));
                recipes.add(NativePatch.readOne(new File(dir, "recipes/aa-tbt-a0bea1c4.recipe")));
            } else if ("libCarPlayCore.so".equals(lib)) recipes.add(NativePatch.readOne(new File(dir, "recipes/carplay-core-wifi.recipe")));
            else if ("libCarPlayAudio.so".equals(lib)) recipes.add(NativePatch.readOne(new File(dir, "recipes/carplay-audio-formats.recipe")));
            else if ("libCarPlayUtils.so".equals(lib)) recipes.add(NativePatch.readOne(new File(dir, "recipes/carplay-utils-converter.recipe")));
            else throw new IllegalArgumentException(lib);
            NativePatch.request(this, lib, recipes);
        } catch (Throwable t) { error("native patch " + lib, t); }
    }
    public void log(String message) { HmgApi.i("[" + id + "] " + message); }
    public void error(String message, Throwable t) { HmgApi.e("[" + id + "] " + message, t); }
    static String md5(String path) {
        try {
            FileInputStream in = new FileInputStream(path); MessageDigest d = MessageDigest.getInstance("MD5");
            byte[] b = new byte[65536]; int n;
            try { while ((n = in.read(b)) > 0) d.update(b, 0, n); } finally { in.close(); }
            StringBuilder out = new StringBuilder();
            for (byte v : d.digest()) out.append(String.format("%02x", v & 255));
            return out.toString();
        } catch (Exception e) { return null; }
    }
}
