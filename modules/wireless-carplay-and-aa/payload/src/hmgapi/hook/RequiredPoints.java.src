package hmgapi.hook;

final class RequiredPoints {
    private RequiredPoints() {}
    static String[] forPart(String part) {
        if ("boot".equals(part)) return new String[] {
            "framework.activity_thread",
            "framework.activity_thread.handle_bind_application",
            "framework.activity_thread.initial_application",
            "framework.app_bind_data",
            "framework.app_bind_data.app_info",
            "framework.app_bind_data.process_name",
        };
        if ("dipo".equals(part)) return new String[] {
            "dipo.bt",
            "dipo.bt.set_carplay_bt_address",
            "dipo.btcm",
            "dipo.btcm.register_listener",
            "dipo.carplay",
            "dipo.carplay.iap_message",
            "dipo.carplay.native_iap_send",
            "dipo.carplay.session_created",
            "dipo.carplay.session_finalized",
            "dipo.carplay.session_started",
            "dipo.iap2",
            "dipo.iap2.bt_address",
            "dipo.iap2.set_notify_on",
            "dipo.iap2_client",
            "dipo.iap2_client.manager",
            "dipo.iap2_listener",
            "dipo.iap2_listener.connected",
            "dipo.iap2_listener.disconnected",
            "dipo.iap2_listener.notify",
            "dipo.iap2_listener.owner",
            "dipo.iap2_proxy",
            "dipo.iap2_proxy.stop_route_guidance",
            "dipo.session_listener",
            "dipo.session_listener.session_details",
            "dipo.utils",
            "dipo.utils.is_support_wireless_carplay",
            "framework.crossroad_name",
            "framework.crossroad_name.name",
            "framework.crossroad_name.new",
            "framework.destination_name",
            "framework.destination_name.name",
            "framework.destination_name.new",
            "framework.destination_name.type",
            "framework.navigation_cluster",
            "framework.navigation_cluster.new",
            "framework.navigation_cluster.update_lane_info",
            "framework.navigation_cluster.update_remain_dis",
            "framework.navigation_cluster.update_tbt_info",
            "framework.navigation_cluster.update_tbt_sub_info_2c",
            "framework.navigation_cluster.update_tbt_sub_info_b",
            "framework.navigation_cluster.update_tp_crossroad_name",
            "framework.navigation_cluster.update_tp_destination_name",
            "framework.navigation_cluster.update_tp_turn_list",
            "framework.navigation_cluster.update_tp_turn_list_new",
            "framework.runtime",
            "framework.runtime.load",
            "framework.runtime.load_library",
            "framework.system_properties",
            "framework.system_properties.get_int",
            "framework.turn_list",
            "framework.turn_list.direction",
            "framework.turn_list.distance",
            "framework.turn_list.exit_number",
            "framework.turn_list.name",
            "framework.turn_list.new",
            "framework.turn_list.no",
            "framework.turn_list.traffic",
            "framework.turn_list.type",
            "framework.turn_list.unit",
            "framework.usm_manager",
            "framework.usm_manager.distance_speed_unit",
            "framework.usm_manager.new",
        };
        if ("iap2".equals(part)) return new String[] {
            "iap2.init_info",
            "iap2.init_info.check_supports_features",
            "iap2.init_info.route_guidance",
            "iap2.service",
            "iap2.service.get_component",
            "iap2.service.is_connected",
            "iap2.service.on_create",
            "iap2.service.receive_connect",
            "iap2.service.receive_disconnect",
            "iap2.service.set_device_serial",
            "iap2.service_receiver",
            "iap2.service_receiver.on_receive",
            "iap2.service_receiver.service",
        };
        if ("gpm".equals(part)) return new String[] {
            "framework.crossroad_name",
            "framework.crossroad_name.name",
            "framework.crossroad_name.new",
            "framework.destination_name",
            "framework.destination_name.name",
            "framework.destination_name.new",
            "framework.destination_name.type",
            "framework.navigation_cluster",
            "framework.navigation_cluster.new",
            "framework.navigation_cluster.update_lane_info",
            "framework.navigation_cluster.update_remain_dis",
            "framework.navigation_cluster.update_tbt_info",
            "framework.navigation_cluster.update_tbt_sub_info_2c",
            "framework.navigation_cluster.update_tbt_sub_info_b",
            "framework.navigation_cluster.update_tp_crossroad_name",
            "framework.navigation_cluster.update_tp_destination_name",
            "framework.navigation_cluster.update_tp_turn_list",
            "framework.navigation_cluster.update_tp_turn_list_new",
            "framework.runtime",
            "framework.runtime.load",
            "framework.runtime.load_library",
            "framework.system_properties",
            "framework.system_properties.get_int",
            "framework.turn_list",
            "framework.turn_list.direction",
            "framework.turn_list.distance",
            "framework.turn_list.exit_number",
            "framework.turn_list.name",
            "framework.turn_list.new",
            "framework.turn_list.no",
            "framework.turn_list.traffic",
            "framework.turn_list.type",
            "framework.turn_list.unit",
            "framework.usm_manager",
            "framework.usm_manager.distance_speed_unit",
            "framework.usm_manager.new",
            "gpm.cluster_type",
            "gpm.cluster_type.enum",
            "gpm.cluster_type.image",
            "gpm.navigation_status",
            "gpm.navigation_status.init",
            "gpm.navigation_status.next_turn",
            "gpm.navigation_status.next_turn_distance",
            "gpm.navigation_status.receiver",
            "gpm.navigation_status.status",
            "gpm.receiver",
            "gpm.receiver.destroy",
            "gpm.receiver.focus_native",
            "gpm.receiver.send_navigation_focus",
        };
        if ("gpm_usb".equals(part)) return new String[] {
            "framework.context_impl",
            "framework.context_impl.start_service",
        };
        if ("navigation".equals(part)) return new String[] {
            "framework.dipo_manager",
            "framework.dipo_manager.is_turn_by_turn",
            "framework.gpm_manager",
            "framework.gpm_manager.is_navi_guidance",
            "framework.gpm_manager.new",
            "framework.navigation_cluster",
            "framework.navigation_cluster.update_remain_dis",
            "framework.navigation_cluster.update_tbt_info",
            "framework.navigation_cluster.update_tbt_sub_info",
            "framework.navigation_cluster.update_tbt_sub_info2",
            "framework.navigation_cluster.update_tbt_sub_info2_b",
            "framework.navigation_cluster.update_tbt_sub_info_2c",
            "framework.navigation_cluster.update_tbt_sub_info_b",
            "framework.navigation_cluster.update_tp_crossroad_name",
            "framework.navigation_cluster.update_tp_destination_name",
            "framework.navigation_cluster.update_tp_lane_info",
            "framework.navigation_cluster.update_tp_turn_list",
            "framework.navigation_cluster.update_tp_turn_list_new",
        };
        if ("btsettings".equals(part)) return new String[] {
            "btsettings.projection_helper",
            "btsettings.projection_helper.device_connections_available",
            "btsettings.projection_helper.open_device_connections",
            "btsettings.projection_helper.open_other_page",
            "btsettings.projection_helper.open_wireless_page",
            "framework.build_info",
            "framework.build_info.region",
        };
        return null;
    }
}
