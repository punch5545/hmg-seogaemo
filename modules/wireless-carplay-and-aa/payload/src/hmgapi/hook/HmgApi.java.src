package hmgapi.hook;

// Modified by HMG-Seogaemo: single wireless projection entry, without the HMG-API app/engine.
import android.app.Application;
import android.content.Context;
import android.content.pm.ApplicationInfo;
import android.util.Log;
import hmgapi.mods.wireless.Wireless;
import java.io.File;
import java.io.FileInputStream;
import java.io.ByteArrayOutputStream;
import org.json.JSONObject;
import java.util.Iterator;

final class HmgApi {
    private HmgApi() {}
    static void i(String msg) { Log.i("HMG-Seogaemo-Wireless", msg); }
    static void e(String msg, Throwable t) { Log.e("HMG-Seogaemo-Wireless", msg, t); }
    static final Wireless ENTRY = new Wireless();
    static final ModContext MOD = new ModContext();

    private static String read(File file) throws Exception {
        FileInputStream in = new FileInputStream(file);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        byte[] buf = new byte[8192]; int n;
        try {
            while ((n = in.read(buf)) > 0) {
                if (out.size() + n > 4194304) throw new IllegalStateException("map too large");
                out.write(buf, 0, n);
            }
        } finally { in.close(); }
        return out.toString("UTF-8");
    }

    private static String property(Class<?> provider, String key) throws Exception {
        return (String) provider.getMethod("get", String.class).invoke(null, key);
    }

    static void zygoteInit() {
        try {
            Class<?> prop = Class.forName("android.os.SystemProperties");
            String product = property(prop, "ro.build.product");
            File enabled = new File("/data/nemesis/backup/hmg-seogaemo/modules/wireless-carplay-and-aa/enabled");
            if (!enabled.isFile()) { i("hooks off: module disabled"); return; }
            File root = new File("/data/nemesis/backup/hmg-seogaemo/car-maps");
            String relative = read(new File(root, "active")).trim();
            if (!relative.matches("[A-Za-z0-9._-]+/[0-9a-f]{32}/[0-9a-f]{32}")) {
                i("hooks off: active map pointer invalid"); return;
            }
            File selected = new File(root, relative);
            JSONObject car = new JSONObject(read(new File(selected, "car.json")));
            if (!product.equals(car.getString("product")) ||
                    !property(prop, "ro.mobis.onebindir").equals(car.getString("onebin")) ||
                    !property(prop, "ro.build.version.release").equals(car.getString("android"))) {
                i("hooks off: car identity changed"); return;
            }
            // The seal holds the product and stock hash the map was verified on, then the boot it
            // was verified in. The zygote starts seconds after boot, long before this boot's
            // verification finishes, so only the first two lines gate the hooks; every stock file
            // is still compared with the MD5s recorded in car.json below.
            String seal = product + "\n" + read(new File(selected, "hash-id")).trim() + "\n";
            if (!read(new File(selected, "verified")).startsWith(seal)) {
                i("hooks off: map not verified for this stock build"); return;
            }
            JSONObject files = car.getJSONObject("files");
            Iterator<String> paths = files.keys();
            while (paths.hasNext()) {
                String file = paths.next();
                if (!file.matches("/system/(?:app|framework)/[A-Za-z0-9_.-]+") ||
                        !files.getString(file).equals(ModContext.md5(file))) {
                    i("hooks off: stock hash mismatch " + file); return;
                }
            }
            JSONObject map = new JSONObject(read(new File(selected, "map.json")));
            Points.use(map);
            if (!Points.needAll("boot", "framework.activity_thread.handle_bind_application", "framework.app_bind_data.app_info", "framework.app_bind_data.process_name", "framework.activity_thread.initial_application")) return;
            Points.hook(null, "framework.activity_thread.handle_bind_application", new MethodHook() {
                @Override protected void afterHookedMethod(Param p) {
                    try {
                        Object data = p.args[0];
                        String pkg = ((ApplicationInfo) Points.get(null, "framework.app_bind_data.app_info", data)).packageName;
                        String process = (String) Points.get(null, "framework.app_bind_data.process_name", data);
                        Application app = (Application) Points.get(null, "framework.activity_thread.initial_application", p.thisObject);
                        if (app != null) ENTRY.appLoaded(MOD, new LoadedApp(pkg, process, app.getClassLoader(), (Context) app));
                    } catch (Throwable t) { e("app hook", t); }
                }
            });
            i("wireless hook ready");
        } catch (Throwable t) { e("zygote hook setup", t); }
    }
}
