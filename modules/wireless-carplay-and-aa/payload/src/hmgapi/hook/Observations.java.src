package hmgapi.hook;

import java.io.File;
import java.io.IOException;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * A small persistent aggregate of what the car and phone were seen to do (turn-by-turn:
 * which icon a maneuver got, which lane data arrived), kept in the app's private runtime
 * directory next to the process records and gathered with them by the root exporter.
 *
 * Bounded: at most MAX_KEYS keys and MAX_BYTES of file; at the limit the least-used, then
 * oldest key goes. Written atomically (.tmp, then rename), on change at most every
 * MIN_WRITE_MS, and when flushed with force (route end). It survives process restarts: the
 * file is read back at first use.
 *
 * File: UTF-8 text, "format=1", "kind=<name>", then one line per key:
 *   key|detail|count|first_ms|last_ms   (epoch milliseconds; "|" and control characters never occur in a field)
 */
public final class Observations {
    static final int MAX_KEYS = 256, MAX_BYTES = 32768, FIELD = 400;
    static final long MIN_WRITE_MS = 30000L;
    /** test clock: a value of 0 or more replaces System.currentTimeMillis */
    static volatile long clock = -1;

    static final class Entry {
        String detail;
        long count, first, last;
    }

    private final String name;
    private final LinkedHashMap<String, Entry> entries = new LinkedHashMap<String, Entry>();
    private boolean loaded, dirty;
    private long wroteAt = Long.MIN_VALUE / 2;

    public Observations(String name) {
        this.name = name;
    }

    static long now() {
        return clock >= 0 ? clock : System.currentTimeMillis();
    }

    static String clean(String s) {
        StringBuilder b = new StringBuilder();
        for (int i = 0; s != null && i < s.length() && b.length() < FIELD; i++) {
            char c = s.charAt(i);
            b.append(c == '|' || Character.isISOControl(c) ? '_' : c);
        }
        return b.toString();
    }

    /** one more sighting of key; detail is the latest outcome for it */
    public synchronized void note(String key, String detail) {
        try {
            load();
            key = clean(key);
            Entry e = entries.get(key);
            long t = now();
            if (e == null) {
                while (entries.size() >= MAX_KEYS) evict();
                e = new Entry();
                e.first = t;
                entries.put(key, e);
            }
            e.detail = clean(detail);
            e.count++;
            e.last = t;
            dirty = true;
        } catch (Throwable ignored) {
            // diagnostics only
        }
    }

    /** writes the file if something changed and 30 s have passed since the last write (or force) */
    public synchronized void flush(boolean force) {
        try {
            if (!dirty) return;
            long t = now();
            if (!force && t - wroteAt < MIN_WRITE_MS) return;
            File dir = RuntimeResult.directoryOrNull();
            if (dir == null) return;
            byte[] bytes = serialize();
            File tmp = new File(dir, name + ".txt.tmp"), target = new File(dir, name + ".txt");
            RuntimeResult.write(tmp, bytes, false);
            if (!tmp.renameTo(target)) throw new IOException("observations rename failed");
            dirty = false;
            wroteAt = t;
        } catch (Throwable ignored) {
            // diagnostics only
        }
    }

    public synchronized int size() {
        return entries.size();
    }

    private void evict() {
        String victim = null;
        Entry worst = null;
        for (Map.Entry<String, Entry> e : entries.entrySet()) {
            Entry v = e.getValue();
            if (worst == null || v.count < worst.count || (v.count == worst.count && v.last < worst.last)) {
                victim = e.getKey();
                worst = v;
            }
        }
        if (victim != null) entries.remove(victim);
    }

    private byte[] serialize() throws IOException {
        while (true) {
            StringBuilder s = new StringBuilder("format=1\nkind=").append(name).append('\n');
            for (Map.Entry<String, Entry> e : entries.entrySet()) {
                Entry v = e.getValue();
                s.append(e.getKey()).append('|').append(v.detail).append('|').append(v.count).append('|').append(v.first).append('|').append(v.last).append('\n');
            }
            byte[] b = s.toString().getBytes("UTF-8");
            if (b.length <= MAX_BYTES || entries.isEmpty()) return b;
            evict();
        }
    }

    /** reads an earlier file back (bounded, malformed lines skipped) */
    private void load() {
        if (loaded) return;
        loaded = true;
        try {
            File dir = RuntimeResult.directoryOrNull();
            if (dir == null) return;
            File f = new File(dir, name + ".txt");
            if (!f.isFile() || f.length() > MAX_BYTES) return;
            String text = RuntimeResult.text(f, MAX_BYTES);
            List<String> lines = new ArrayList<String>();
            for (String l : text.split("\n")) lines.add(l);
            for (String l : lines) {
                String[] p = l.split("\\|", -1);
                if (p.length != 5 || entries.size() >= MAX_KEYS) continue;
                Entry e = new Entry();
                try {
                    e.count = Long.parseLong(p[2]);
                    e.first = Long.parseLong(p[3]);
                    e.last = Long.parseLong(p[4]);
                } catch (NumberFormatException x) {
                    continue;
                }
                e.detail = clean(p[1]);
                entries.put(clean(p[0]), e);
            }
        } catch (Throwable ignored) {
            // an unreadable old file just starts over
        }
    }
}
