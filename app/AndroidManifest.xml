<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.seogaemo.hmg"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION@">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <!-- HMG's ActivityManager checks GET_TASKS in finishActivity(). -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="@string/app_name"
        android:icon="@drawable/launcher_icon"
        android:theme="@style/Hkmc"
        android:allowBackup="false">
        <!-- Android 8+ emulator: opt into Gen5W wide aspect ratio; ignored by Android 4.4. -->
        <meta-data android:name="android.max_aspect" android:value="2.7" />
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/Hkmc"
            android:screenOrientation="landscape"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".UserButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.seogaemo.hmg.USER_BUTTON_SHORTCUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
