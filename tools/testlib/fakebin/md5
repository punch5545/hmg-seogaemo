#!/bin/sh
# Android 4.4 toolbox md5 output for host-side root script tests: "<hex>  <name>".
# Absolute host tools: tests run root scripts with a restricted PATH.
for tool in /usr/bin/md5sum /bin/md5sum /sbin/md5sum; do
    [ -x "$tool" ] && break
done
digest() {
    if [ -x "$tool" ]; then
        out=$("$tool") || return 1
        echo "${out%% *}"
    else
        /sbin/md5 -q
    fi
}
if [ "$#" -eq 0 ]; then
    echo "md5 file ..." >&2
    exit 1
fi
failed=0
for name do
    case "$name" in
        /proc/self/fd/0) sum=$(digest) ;;
        *) sum=$(digest < "$name") ;;
    esac || { failed=1; continue; }
    echo "$sum  $name"
done
exit "$failed"
