#!/usr/bin/env python3
"""Android 4.4 toolbox md5 output for host-side root script tests."""
import hashlib
import sys


def digest(stream):
    value = hashlib.md5()
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        value.update(chunk)
    return value.hexdigest()


if len(sys.argv) == 1:
    print("md5 file ...", file=sys.stderr)
    sys.exit(1)
else:
    failed = False
    for name in sys.argv[1:]:
        try:
            with (sys.stdin.buffer if name == "/proc/self/fd/0" else open(name, "rb")) as source:
                print(f"{digest(source)}  {name}")
        except OSError as error:
            print(f"md5: {name}: {error.strerror}", file=sys.stderr)
            failed = True
    if failed:
        sys.exit(1)
