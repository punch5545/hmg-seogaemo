#!/system/bin/sh
umask 077
if [ "$#" -ne 2 ]; then
    echo 'usage: hmg-seogaemo-root <id> apply|revert|status|precheck' >&2
    exit 2
fi
base=${0%/*}
base=${base%/bin}
SG_DATA_ROOT=${SG_DATA_ROOT:-/data/nemesis/backup/hmg-seogaemo}
if [ "$1" = export ]; then
    case "$2" in usb|adb) ;; *) exit 2;; esac
    [ -f "$SG_DATA_ROOT/ledger/ledger.tsv" ] || {
        echo 'state=failed'; echo 'restart=none'; echo 'detail=No change ledger'; exit 1;
    }
    if [ "$2" = usb ]; then
        export_base=
        for drive in ${SG_USB_DIRS:-/storage/usb0 /storage/usb1 /storage/usb2 /mnt/media_rw/usb0 /mnt/media_rw/usb1 /mnt/media_rw/usb2}; do
            grep -q " $drive " "${SG_MOUNTS_FILE:-/proc/mounts}" 2>/dev/null || continue
            export_base=$drive
            break
        done
        [ -n "$export_base" ] || {
            echo 'state=failed'; echo 'restart=none'; echo 'detail=No mounted USB drive'; exit 1;
        }
    else
        export_base=${SG_EXPORT_ROOT:-/data/local/tmp/hmg-seogaemo-export}
    fi
    size=0
    for record in "$SG_DATA_ROOT"/ledger/ledger.tsv "$SG_DATA_ROOT"/ledger/before/* "$SG_DATA_ROOT"/ledger/after/*; do
        [ -f "$record" ] || continue
        set -- $(ls -ln "$record")
        case "$5" in *[!0-9]*|'') record_size=$4;; *) record_size=$5;; esac
        size=$((size + record_size))
    done
    [ "$size" -le 52428800 ] || {
        echo 'state=failed'; echo 'restart=none'; echo 'detail=Ledger exceeds 50 MB'; exit 1;
    }
    stamp=$(date +%Y%m%d-%H%M%S)
    case "$export_base" in */hmg-seogaemo-export) dest=$export_base/$stamp;; *)
        dest=$export_base/HMG-Seogaemo-export/$stamp;; esac
    mkdir -p "$dest" || exit 1
    cp -R "$SG_DATA_ROOT/ledger" "$dest/ledger" || exit 1
    mkdir -p "$dest/desired" || exit 1
    for record in "$SG_DATA_ROOT"/desired/*; do
        [ -f "$record" ] && cp "$record" "$dest/desired/" || true
    done
    getprop ro.build.product > "$dest/ro.build.product"
    grep '^package-version=' "$base/NEMESIS.data" > "$dest/package-version"
    chmod -R 755 "$dest" || exit 1
    printf 'state=on\nrestart=none\ndetail=%s\n' "$dest"
    exit 0
fi
if [ "$1" = update ]; then
    case "$2" in stage|apply|rollback|status) ;; *) exit 2 ;; esac
    base=${0%/*}
    base=${base%/bin}
    exec sh "$base/core/update.sh" "$2"
fi
case "$1" in
    ''|*[!a-z0-9-]*|-*|*--*|*-) exit 2 ;;
esac
case "$2" in apply|revert|status|precheck) ;; *) exit 2 ;; esac
base=${0%/*}
base=${base%/bin}
[ -L /data/nemesis/backup/hmg-seogaemo/update/current ] && base=/data/nemesis/backup/hmg-seogaemo/update/current
[ "$base" != "$0" ] || exit 2
[ -f "$base/modules.list" ] || exit 2
grep -Fxq "$1" "$base/modules.list" || exit 2
script=$base/modules/$1.sh
[ -f "$script" ] || exit 2
HMG_SEOGAEMO_BASE=$base
HMG_SEOGAEMO_STATE=$SG_DATA_ROOT/modules/$1
HMG_SEOGAEMO_MODULE_DIR=$base/modules/$1.d
export HMG_SEOGAEMO_BASE HMG_SEOGAEMO_STATE HMG_SEOGAEMO_MODULE_DIR SG_DATA_ROOT
if [ "$2" = status ] || [ "$2" = precheck ]; then
    exec sh "$script" "$2"
fi
mkdir -p "$SG_DATA_ROOT/desired" "$SG_DATA_ROOT/modules" || exit 1
chmod 700 "$SG_DATA_ROOT" "$SG_DATA_ROOT/desired" "$SG_DATA_ROOT/modules" || exit 1
lock=$SG_DATA_ROOT/operation.lock
tries=0
while ! mkdir "$lock" 2>/dev/null; do
    if [ -f "$lock/pid" ]; then
        holder=$(cat "$lock/pid" 2>/dev/null)
        case "$holder" in ''|*[!0-9]*) ;; *)
            if ! kill -0 "$holder" 2>/dev/null; then rm -rf "$lock"; continue; fi ;;
        esac
    fi
    tries=$((tries + 1))
    [ "$tries" -lt 10 ] || { echo 'module operation busy' >&2; exit 1; }
    sleep 1
done
printf '%s' "$$" > "$lock/pid"
trap 'rm -rf "$lock"' EXIT HUP INT TERM
relation() {
    relation_id=$1; relation_field=$2
    while IFS='	' read -r graph_id graph_dep graph_exc; do
        [ "$graph_id" = "$relation_id" ] || continue
        case "$relation_field" in
            depends) printf '%s\n' "${graph_dep#depends=}" ;;
            excludes) printf '%s\n' "${graph_exc#excludes=}" ;;
        esac
        return
    done < "$base/modules.graph"
}
desired_on() { [ -f "$SG_DATA_ROOT/desired/$1" ] && [ "$(cat "$SG_DATA_ROOT/desired/$1")" = on ]; }
if [ "$2" = apply ]; then
    [ -f "$base/modules.graph" ] || exit 1
    old_ifs=$IFS; IFS=,
    for dep in $(relation "$1" depends); do
        [ -z "$dep" ] || desired_on "$dep" || { echo "dependency off: $dep" >&2; exit 3; }
    done
    for excluded in $(relation "$1" excludes); do
        [ -z "$excluded" ] || ! desired_on "$excluded" || { echo "excluded module on: $excluded" >&2; exit 3; }
    done
    IFS=$old_ifs
else
    # A direct root call may not leave an enabled dependent behind.
    for other in $(cat "$base/modules.list"); do
        [ "$other" = "$1" ] && continue
        case ",$(relation "$other" depends)," in *,"$1",*)
            desired_on "$other" && { echo "dependent on: $other" >&2; exit 3; } ;;
        esac
    done
fi
printf '%s %s %s\n' "$(date +%s)" "$1" "$2" > "$SG_DATA_ROOT/journal.tmp.$$" &&
    mv -f "$SG_DATA_ROOT/journal.tmp.$$" "$SG_DATA_ROOT/journal" || exit 1
result=$SG_DATA_ROOT/result.$$
sh "$script" "$2" > "$result" 2>&1
code=$?
if [ "$code" -eq 0 ] && [ "$2" = apply ]; then
    . "$base/lib/common.sh"
    sg_reapply_binds >> "$result" 2>&1 || code=1
fi
dd if="$result" bs=1 count=4096 2>/dev/null
if [ "$code" -eq 0 ]; then
    case "$2" in
        apply) grep -q '^state=on$' "$result" ||
            grep -q '^state=pending-restart$' "$result" || code=1 ;;
        revert) grep -q '^state=off$' "$result" || code=1 ;;
    esac
fi
if [ "$code" -eq 0 ]; then
    case "$2" in apply) value=on;; revert) value=off;; esac
    printf '%s' "$value" > "$SG_DATA_ROOT/desired/$1.tmp.$$" &&
        mv -f "$SG_DATA_ROOT/desired/$1.tmp.$$" "$SG_DATA_ROOT/desired/$1" || code=1
fi
rm -f "$result"
exit "$code"
